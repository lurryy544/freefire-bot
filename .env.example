# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram id (можно несколько через запятую) — сюда приходят заказы
BOT_OWNER_ID=

# Номер карты для оплаты
PAYMENT_CARD=

# Имя получателя на карте
CARD_HOLDER=

# Подпись (номер заказа/логин поддержки) рядом с картой — можно оставить пустым
ADMIN_COMMENT=

# Прокси для доступа к api.telegram.org (если используется) — иначе оставьте пустым
PROXY_URL=